# ---------------------------------------------------------------------------
# Course Video Generator - environment configuration
#
# Copy this file to .env if you want to override the built-in defaults.
#
# AI content generation defaults to the local mock provider and requires
# no API key. OpenAI is optional.
#
# Narration defaults to Kokoro, which runs locally after its required
# models have been downloaded.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI content provider
# ---------------------------------------------------------------------------

# Options:
#   "mock"    - default, deterministic and offline
#   "openai"  - OpenAI API
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=

# OpenAI configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1


# ---------------------------------------------------------------------------
# Text-to-speech
# ---------------------------------------------------------------------------

# TTS providers:
#
#   "kokoro"    - default local neural TTS
#                 Default voice: af_heart
#
#   "kyutai"    - Kyutai Pocket TTS, local neural TTS
#                 Example voices:
#                 alba, marius, javert, fantine, jean, cosette,
#                 eponine, azelma
#
#   "edge-tts"  - Microsoft neural voices
#                 Requires an internet connection
#
#   "sapi"      - Windows built-in speech engine
#                 Offline Windows fallback
#
#   "mock"      - deterministic test/demo audio provider

TTS_PROVIDER=kokoro
TTS_VOICE=af_heart

# Speech rate.
# Primarily used by providers that support rate adjustment,
# such as Edge TTS and SAPI.
TTS_RATE=0


# ---------------------------------------------------------------------------
# Model cache
# ---------------------------------------------------------------------------

# Local TTS providers may download models on first use.
#
# HF_HOME can be used to place Hugging Face model data on another drive.
#
# Example on Windows:
#
# HF_HOME=D:\remotion\cache\hf


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
CODEC=h264


# ---------------------------------------------------------------------------
# Video style
# ---------------------------------------------------------------------------

# Available presets:
#   studio
#   dark
#   playful
#   minimal
#   cinema

STYLE=studio

# Scene transition:
#   fade
#   slide
#   wipe
#   zoom

TRANSITION=fade

# ---------------------------------------------------------------------------
# Timing
# ---------------------------------------------------------------------------

SCENE_INTRO_PADDING=0.3
SCENE_OUTRO_PADDING=0.5


# ---------------------------------------------------------------------------
# Optional Remotion configuration
# ---------------------------------------------------------------------------

# Point Remotion at a system FFmpeg executable if necessary.
#
# Windows example:
# REMOTION_FFMPEG_EXECUTABLE=C:\ffmpeg\bin\ffmpeg.exe


# Point Remotion at an installed browser if necessary.
#
# Windows Chrome example:
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe


# Optional parallel rendering concurrency.
#
# Example:
# REMOTION_CONCURRENCY=8


# ---------------------------------------------------------------------------
# Optional temporary directory
# ---------------------------------------------------------------------------

# Useful when the system drive has limited free space.
#
# Windows example:
#
# TMP=D:\remotion\.tmp
# TEMP=D:\remotion\.tmp