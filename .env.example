# ---------------------------------------------------------------------------
# Course Video Generator - environment configuration
# Copy to .env and fill in values only when using live providers.
# The default demo mode uses local mock providers and needs NO API keys.
# ---------------------------------------------------------------------------

# AI content provider: "mock" (default, offline) or "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# TTS provider:
#   "kyutai"   (default) - Kyutai Pocket TTS, local neural voice, fully offline
#              Preset voices: alba (warm female), marius (male), javert (deep
#              male), fantine (soft female), jean, cosette, eponine, azelma
#              First use downloads the model into the HF cache below.
#   "edge-tts"           - Microsoft neural voices, human-sounding, needs internet
#   "sapi"               - Windows built-in speech voice (offline fallback)
#   "mock"               - spoken-syllable tone for headless demos
TTS_PROVIDER=kyutai
TTS_VOICE=marius
# Speech rate: -10 .. 10 (edge-tts and SAPI); slightly negative is a calmer teaching pace
TTS_RATE=0

# Kyutai downloads its model to HF_HOME on first use. Keep it off C: on
# Windows; the pipeline passes cache/ automatically, this overrides it.
# HF_HOME=D:\remotion\cache\hf

# Rendering
FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
CODEC=h264

# Video style preset: studio, dark, playful, minimal, cinema
# (also selectable per run with `--style dark`)
STYLE=studio

# Timing
SCENE_INTRO_PADDING=0.3
SCENE_OUTRO_PADDING=0.5

# Optional: point Remotion at a system ffmpeg if the bundled download is unavailable
# REMOTION_FFMPEG_EXECUTABLE=C:\ffmpeg\bin\ffmpeg.exe

# Optional: point Remotion at a system browser (avoids downloading headless Chrome)
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: parallel render workers (e.g. 8 on an 8-core machine)
# REMOTION_CONCURRENCY=8

# Optional: on Windows, render frames go to the OS temp dir; point it at a
# drive with free space if C: is nearly full
# TMP=D:\remotion\.tmp
# TEMP=D:\remotion\.tmp
